# Copia este ficheiro para .env e substitui os valores de exemplo.
# O .env nunca deve ser publicado nem enviado para o Git.

APP_NAME="MonanaEclésia"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://SEU-DOMINIO.example
# Vazio para instalar no domínio raiz; por exemplo /monana-eclesia em subpasta.
APP_BASE_PATH=
APP_TIMEZONE=Africa/Luanda
APP_FORCE_HTTPS=true
# Segredo aleatório de 32 bytes (64 caracteres hex), usado para cifrar payloads
# de links na fila de email. Obrigatório para criar igrejas/links de recuperação.
APP_ENCRYPTION_KEY=
# Chave aleatória de utilização única para criar o primeiro Superadmin pela rota
# /instalacao/superadmin. Remove-a do .env imediatamente após o primeiro uso.
SUPERADMIN_BOOTSTRAP_TOKEN=

# A aplicação usa exclusivamente MySQL/MariaDB através de PDO.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nome_da_base
DB_USERNAME=utilizador_da_base
DB_PASSWORD=""
DB_CHARSET=utf8mb4

# Use smtp para PHPMailer; log não envia e apenas mantém o estado de falha na fila.
# Brevo e Mailgun podem ser usados pelo respectivo relay SMTP.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responder@example.com
MAIL_FROM_NAME="MonanaEclésia"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls

# Expiração por inactividade, em minutos.
SESSION_NAME=monana_session
SESSION_LIFETIME_MINUTES=30
