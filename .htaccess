# .htaccess - Routing centralizado (arquitectura MVC)
# Projecto instalado na subpasta "monana-eclesia"
# (ex.: http://localhost/monana-eclesia/members)
RewriteEngine On

# ============================================
# PÁGINA DE ERRO 404 PERSONALIZADA
# ============================================
# NOTA: a InfinityFree substitui automaticamente qualquer pasta chamada
# "errors" pela página de erro genérica deles. Por isso a pasta chama-se
# "paginas-erro" e não "errors".
ErrorDocument 404 /monana-eclesia/paginas-erro/404.php

# ============================================
# REDIRECIONAR /modules/<m>/<acao>.php -> /<m>/<acao>
# ============================================
# Mantém os bookmarks antigos a funcionar: qualquer URL legado com o
# prefixo /modules/ é redirecionado (301) para a rota amigável nova.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^modules/(auth/(?:login|logout|forgot-password|reset-password))\.php$ modules/$1 [R=301,L]
RewriteRule ^modules/([a-z\-]+)/index\.php$ $1 [R=301,L]
RewriteRule ^modules/([a-z\-]+)/([a-z\-]+)\.php$ $1/$2 [R=301,L]
RewriteRule ^modules/([a-z\-]+)/$ $1 [R=301,L]

# ============================================
# ESCONDER A EXTENSÃO .PHP (URLs diretos antigos)
# ============================================
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+((?!modules/).+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ============================================
# FRONTP CONTROLLER
# ============================================
# Tudo o que não for um ficheiro ou pasta real vai para public/index.php
# (que carrega config/bootstrap.php + core/Router.php).
# O Router remove o prefixo da subpasta automaticamente.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# ============================================
# SEGURANÇA
# ============================================
# Impedir listagem de diretórios
Options -Indexes

# Proteger arquivos sensíveis
<FilesMatch "\.(htaccess|htpasswd|ini|log|sql|json|yml|yaml)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger pastas internas (config, includes, core, controllers, models, views, modules)
<IfModule mod_rewrite.c>
    RewriteRule ^(config|includes|core|controllers|models|views|_build)/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
</IfModule>
