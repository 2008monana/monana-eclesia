# ============================================================
# Raiz do projecto: tudo passa por public/ (esconde .env, vendor, app, storage...)
# Em produção o ideal é apontar o DocumentRoot para public/.
# ============================================================
Options -Indexes
RewriteEngine On

# Já está a pedir algo dentro de public/: não reescrever
RewriteRule ^public(/|$) - [L]

RewriteRule ^$ public/ [L]
RewriteRule ^(.*)$ public/$1 [L]
