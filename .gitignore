# ============================================================
# Monana Eclesia — Git Ignore
# ============================================================

# Dependências (Composer)
/vendor/

# Ambiente
.env
.env.local
.env.production
.env.*.local

# Logs
*.log
/storage/logs/*
!/storage/logs/.gitkeep

# Cache
/storage/cache/*
!/storage/cache/.gitkeep

# Sessões
/storage/sessions/*
!/storage/sessions/.gitkeep

# Backups de base de dados
/storage/backups/*
!/storage/backups/.gitkeep

# Uploads (ficheiros enviados por utilizadores)
/public/uploads/**/*
!/public/uploads/.gitkeep
!/public/uploads/logos/.gitkeep
!/public/uploads/membros/.gitkeep
!/public/uploads/comprovativos/.gitkeep

# Ficheiros temporários
*.tmp
*.temp
*.swp
*~

# IDE / Editor
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Composer lock (opcional — descomente se quiser ignorar)
# composer.lock

# Node (se um dia houver)
node_modules/
npm-debug.log
yarn-error.log

# Builds
/dist/
/build/